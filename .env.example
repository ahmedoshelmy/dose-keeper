# Copy to .env to override compose defaults. No secrets are needed to run locally.
# CRON (6 fields, UTC) for the timer triggers; e.g. "0 */1 * * * *" to fire every minute while testing.
REFILL_CHECK_SCHEDULE=0 0 2 * * *
WEEKLY_REPORT_SCHEDULE=0 0 6 * * Sat
# Safety net: restart missing or failed reminder loops (also POST /api/reminders/repair).
REMINDER_REPAIR_SCHEDULE=0 */15 * * * *
# POST /api/demo/seed loads synthetic history when true (compose default).
DEMO_SEED=true
